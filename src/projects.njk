---
layout: base.njk
title: Projects
permalink: /projects/
description: "Things Soham Nawthale built: personal projects, hackathon entries, and coursework in C, Unity, and Swift."
---

<header class="page-header">
    <h1>Projects</h1>
    <p class="lede">
        Things I built because a hackathon, a class, or an itch demanded it. Jobs are under
        <a href="/experience/">Experience</a> and lab work under <a href="/research/">Research</a>.
    </p>
</header>

<section class="section" id="founded" style="margin-top:0">
    <div class="section-head">
        <h2>Founded</h2>
    </div>
    <ol class="entries">
        <li class="entry">
            <div class="entry-meta"><span>Aug 2025 – May 2026</span></div>
            <div class="entry-body">
                <h3 class="entry-title"><a href="/ProjectEMBER/">Project EMBER</a></h3>
                <p class="entry-context">Student-led solar-thermal design team · Virginia Tech</p>
                <p>
                    A solar thermal panel that converts roughly 60% of incident energy into useful heat, plus the
                    software around it: a materials simulator, on-device telemetry, and a feedback loop that
                    adjusts flow rate without a human watching. Founded and led it for one academic year.
                </p>
                <p class="entry-stack">Python, Arduino, C++</p>
            </div>
        </li>
    </ol>
</section>

{% set groups = [
    { "key": "personal",   "title": "Personal" },
    { "key": "hackathon",  "title": "Hackathons", "note": "Forty-eight hours, a team of four, and whatever idea survived the first coffee." },
    { "key": "coursework", "title": "Coursework" }
] %}

{% for group in groups %}
<section class="section" id="{{ group.key }}">
    <div class="section-head">
        <h2>{{ group.title }}</h2>
        {% if group.note %}<span class="meta">{{ group.note }}</span>{% endif %}
    </div>
    <ol class="entries">
        {% for p in projects | where("group", group.key) %}
        <li class="entry">
            <div class="entry-meta">
                <span>{{ p.when }}</span>
                {% if p.status %}<span>{{ p.status }}</span>{% endif %}
            </div>
            <div class="entry-body">
                <h3 class="entry-title">{% if p.link %}<a href="{{ p.link }}">{{ p.title }}</a>{% else %}{{ p.title }}{% endif %}</h3>
                {% if p.context %}<p class="entry-context">{{ p.context }}</p>{% endif %}
                <p>{{ p.summary }}</p>
                <p class="entry-stack">{{ p.stack }}{% if p.link %} · <a href="{{ p.link }}">{{ p.linkLabel or "Source" }}</a>{% endif %}</p>
            </div>
        </li>
        {% endfor %}
    </ol>
</section>
{% endfor %}
